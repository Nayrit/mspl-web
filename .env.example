# Admin authentication (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Must be 32+ random characters in production (signs admin session cookies)
ADMIN_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional - analytics loads only after cookie consent
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Deployment notes:
# - CMS writes to data/ and public/uploads/ — use a host with persistent disk
#   (or migrate to object storage / a database). Serverless alone will lose edits.
# - Contact + careers email via FormSubmit; activate the company inbox or switch
#   to first-party email (SES / Resend) before handling production CVs.
